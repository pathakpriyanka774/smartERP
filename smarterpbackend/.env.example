# SmartERP backend configuration
# Copy to .env and fill in real values:  cp .env.example .env
#
# Database settings are read by shared/database.js (PostgreSQL via `pg`) and by
# ../setup-database.js, which creates the database and applies ../postgres/*.sql.
#
# Hosted database (Neon, Render, RDS): set DATABASE_URL and the DB_* values
# below are ignored. For Neon, use the pooled connection string from the
# console (host contains "-pooler", ends in ?sslmode=require); migrations prefer
# DATABASE_URL_UNPOOLED (the direct string) when it is set.
# DATABASE_URL=postgresql://USER:YOUR_DB_PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:YOUR_DB_PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=smarterp

# A dedicated login role, not the postgres superuser. Create it once with:
#   sudo -u postgres psql -c "CREATE ROLE smarterp WITH LOGIN PASSWORD '<password>';"
#   sudo -u postgres psql -c "CREATE DATABASE smarterp OWNER smarterp;"
DB_USER=smarterp
DB_PASSWORD=YOUR_DB_PASSWORD

# TLS to the database. Leave false for a local server; set true for a managed
# one (e.g. Amazon RDS). DB_SSL_REJECT_UNAUTHORIZED=false accepts a
# self-signed certificate and should only be used in development.
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Connections per service process.
# DB_POOL_MAX=10

# Signing key for auth-service JWTs. Generate with:
#   head -c 48 /dev/urandom | base64 | tr -dc "A-Za-z0-9" | head -c 64
JWT_SECRET=YOUR_JWT_SECRET

# Timezone for user-facing timestamps (IANA name). Database sessions run in UTC,
# so attendance times and dates are derived in the app.
APP_TIMEZONE=Asia/Kolkata

# Check-ins after this time (HH:MM, app timezone) are recorded as late.
ATTENDANCE_LATE_AFTER=10:30

# Where services listen. Loopback by default, so only the gateway on this
# machine can reach them (each service also enforces its area permission).
# Use 0.0.0.0 only if the gateway runs on another host AND the service ports
# are firewalled to it.
# SERVICE_HOST=127.0.0.1

# Database backups (node scripts/backup-database.js). Dumps contain personal
# data: keep the directory private and off source control.
# BACKUP_DIR=../backups
# BACKUP_KEEP=30

# Session checks. Every request re-reads the account (active? token revoked?
# current permissions) from the database, cached this long per user, so a
# deactivated user or a removed permission stops working within this time.
# SESSION_CACHE_MS=5000

# Login throttling (per 15 minutes) and signup throttling (per hour).
# LOGIN_MAX_PER_ACCOUNT=5
# LOGIN_MAX_PER_ADDRESS=20
# SIGNUP_MAX_PER_ADDRESS=10
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=https://smarterpfrontend.vercel.app,http://localhost:3000
