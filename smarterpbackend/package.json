{
  "name": "erp-microservices-backend",
  "version": "1.0.0",
  "description": "Microservices backend for ERP system",
  "scripts": {
    "start:pm2": "pm2-runtime ecosystem.config.cjs",
  "start:pm2:local": "pm2 start ecosystem.config.cjs",
  "monitor": "pm2 monit",
  "logs": "pm2 logs",
    "start:gateway": "node gateway/server.js",
    "start:auth": "node services/auth-service/server.js",
    "start:orders": "node services/order-service/server.js",
    "start:inventory": "node services/inventory-service/server.js",
    "start:finance": "node services/finance-service/server.js",
    "start:clients": "node services/client-service/server.js",
    "start:reports": "node services/report-service/server.js",
    "start:payroll": "node services/payroll-service/server.js",
    "start:production-planning": "node services/production-planning-service/server.js",
    "start:costing": "node services/costing-service/server.js",
    "start:attendance": "node services/attendance-service/server.js",
    "start:builder": "node services/page-builder-service/server.js",
    "start:accounting": "node services/accounting-service/server.js",
    "start:purchases": "node services/purchase-service/server.js",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:orders\" \"npm run start:inventory\" \"npm run start:finance\" \"npm run start:clients\" \"npm run start:reports\" \"npm run start:payroll\" \"npm run start:production-planning\" \"npm run start:costing\" \"npm run start:attendance\" \"npm run start:builder\" \"npm run start:accounting\" \"npm run start:purchases\"",
    "test": "node --test --test-concurrency=1 tests/integration.test.js",
    "db:migrate": "node ../setup-database.js",
    "db:status": "node ../setup-database.js --status",
    "db:backup": "node ../scripts/backup-database.js --keep 30",
    "db:restore": "node ../scripts/restore-database.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.9",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pm2": "^7.1.0"
  },
  "keywords": [
    "erp",
    "microservices",
    "nodejs",
    "express"
  ],
  "author": "ERP Team",
  "license": "MIT",
  "devDependencies": {
    "mssql": "^11.0.2"
  }
}
