{
  "name": "erp-microservices-backend",
  "version": "1.0.0",
  "description": "Microservices backend for ERP system",
  "scripts": {
    "start:gateway": "node gateway/server.js",
    "start:auth": "node services/auth-service/server.js",
    "start:orders": "node services/order-service/server.js",
    "start:inventory": "node services/inventory-service/server.js",
    "start:production": "node services/production-service/server.js",
    "start:finance": "node services/finance-service/server.js",
    "start:clients": "node services/client-service/server.js",
    "start:reports": "node services/report-service/server.js",
    "start:payroll": "node services/payroll-service/server.js",
    "start:production-planning": "node services/production-planning-service/server.js",
    "start:costing": "node services/costing-service/server.js",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:orders\" \"npm run start:inventory\" \"npm run start:production\" \"npm run start:finance\" \"npm run start:clients\" \"npm run start:reports\" \"npm run start:payroll\" \"npm run start:production-planning\" \"npm run start:costing\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.9",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1"
  },
  "keywords": [
    "erp",
    "microservices",
    "nodejs",
    "express"
  ],
  "author": "ERP Team",
  "license": "MIT"
}
